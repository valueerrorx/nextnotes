<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="bootstrap.php"
	colors="false"
	failOnWarning="true"
	failOnRisky="true"
	failOnEmptyTestSuite="true"
	cacheDirectory=".phpunit.cache">
	<testsuites>
		<testsuite name="nextnotes">
			<directory>php</directory>
		</testsuite>
	</testsuites>
	<!-- destructive: löscht alle App-Daten (PurgeTest), nur über dev/nextcloud/check-purge.sh -->
	<groups>
		<exclude>
			<group>destructive</group>
		</exclude>
	</groups>
</phpunit>
