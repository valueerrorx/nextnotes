		{
			"from": "js/katex/katex.min.js",
			"to": "js/vendor/katex/katex.min.js"
		},
		{
			"from": "js/highlight",
			"to": "js/vendor/highlight"
		},
		{
			"from": "js/Sortable.min.js",
			"to": "js/vendor/Sortable.min.js"
		},
		{
			"from": "js/katex/fonts",
			"to": "css/vendor/katex/fonts"
		},
		{
			"from": "js/katex/katex.min.css",
			"to": "css/vendor/katex.min.css",
			"rewriteUrls": true
		}
	],
	"adapterHooks": [
		{
			"file": "js/globals.js",
			"text": "window.poznoteAssetUrl = function",
			"by": "nextnotes-late.js"
		},
		{
			"file": "js/lazy-libs.js",
			"text": "window.poznoteEnsureScript = ensureScript",
			"by": "nextnotes-late.js"
		},
		{
			"file": "js/lazy-libs.js",
			"text": "window.poznoteEnsureMermaid = function",
			"by": "nextnotes-late.js"
		},
		{
			"file": "js/lazy-libs.js",
			"text": "window.poznoteEnsureKatex = function",
			"by": "nextnotes-late.js"
		},
		{
			"file": "js/theme-manager.js",
			"text": "window.__poznoteThemeStorage",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/theme-manager.js",
			"text": "window.__poznoteThemeList",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/theme-manager.js",
			"text": "window.applyTheme = applyTheme",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/globals.js",
			"text": "fetch('api/v1/system/i18n'",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/globals.js",
			"text": "window.t && window.loadPoznoteI18n",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/note-edit-lock.js",
			"text": "SESSION_STORAGE_KEY = 'poznote_editor_session_id'",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/events-auto-save.js",
			"text": "keepalive: true",
			"by": "nextnotes-bootstrap.js"
		},
		{
			"file": "js/note-loader.js",
			"text": "xhr.setRequestHeader('X-Poznote-Fragment', 'right_col')",
			"by": "PageController::fragment"
		}
	],
