	"stripFontFace": {
		"match": "webfonts/",
		"reason": "Schrift Inter gestrichen, var(--font-face) (ADR 0016); sonst 404 auf webfonts/"
	},
	"fontFamilyRewrite": {
		"from": "Inter",
		"to": "var(--font-face)",
		"reason": "Schrift = NC-Schrift inkl. Legasthenie-Schrift (ADR 0016); Upstream setzt 'Inter' in font-family (teils !important)"
	},
	"vendor": [
		{
			"from": "js/codemirror-dist",
			"to": "js/vendor/codemirror-dist"
		},
		{
			"from": "js/excalidraw-dist",
			"to": "js/vendor/excalidraw-dist"
		},
		{
			"from": "js/mermaid/mermaid.min.js",
			"to": "js/vendor/mermaid/mermaid.min.js"
