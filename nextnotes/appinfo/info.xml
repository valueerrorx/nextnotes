<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>nextnotes</id>
	<name>Next Notes</name>
	<summary>Notes, folders and workspaces for Nextcloud</summary>
	<description><![CDATA[Next Notes is a native Nextcloud app for notes, folders, tags and shared workspaces.

Based on Poznote by Timothé Poznanski (MIT).]]></description>
	<version>0.3.3</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>Thomas Weissel</author>
	<namespace>NextNotes</namespace>
	<category>office</category>
	<category>organization</category>
	<bugs>https://github.com/valueerrorx/nextnotes/issues</bugs>
	<repository type="git">https://github.com/valueerrorx/nextnotes</repository>
	<dependencies>
		<php min-version="8.3" max-version="8.5"/>
		<nextcloud min-version="35" max-version="35"/>
	</dependencies>
	<background-jobs>
		<job>OCA\NextNotes\BackgroundJob\LockCleanupJob</job>
		<job>OCA\NextNotes\BackgroundJob\SnapshotRetentionJob</job>
		<job>OCA\NextNotes\BackgroundJob\ReminderJob</job>
		<job>OCA\NextNotes\BackgroundJob\DeletedWorkspaceSweepJob</job>
		<job>OCA\NextNotes\BackgroundJob\ExportTempCleanupJob</job>
		<job>OCA\NextNotes\BackgroundJob\CleanupJob</job>
		<job>OCA\NextNotes\BackgroundJob\AssignmentDeadlineJob</job>
	</background-jobs>
	<commands>
		<command>OCA\NextNotes\Command\TeamOrphanCheck</command>
		<command>OCA\NextNotes\Command\AssignmentTransfer</command>
		<command>OCA\NextNotes\Command\ExportUser</command>
		<command>OCA\NextNotes\Command\DeleteUserData</command>
		<command>OCA\NextNotes\Command\Purge</command>
	</commands>
	<settings>
		<admin>OCA\NextNotes\Settings\AdminSettings</admin>
		<admin-section>OCA\NextNotes\Settings\AdminSection</admin-section>
	</settings>
	<navigations>
		<navigation>
			<name>Next Notes</name>
			<route>nextnotes.page.index</route>
			<icon>app.svg</icon>
		</navigation>
	</navigations>
</info>
